rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'akakabdelmalek@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidGrade(grade) {
      return grade in ['1AM', '2AM', '3AM', '4AM'];
    }

    // Strict Validation Blueprint for StudentRanking (mirrors firebase-blueprint.json)
    function isValidStudentRanking(data) {
      return data.keys().hasAll([
          'ownerUid',
          'firstName',
          'name',
          'grade',
          'points',
          'avatar',
          'badge',
          'testsCompleted',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'firstName',
          'name',
          'grade',
          'points',
          'avatar',
          'badge',
          'testsCompleted',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 60
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && isValidGrade(data.grade)
        && data.points is number && data.points >= 0 && data.points <= 1000000
        && data.avatar is string && data.avatar.size() >= 1 && data.avatar.size() <= 16
        && data.badge is string && data.badge.size() >= 1 && data.badge.size() <= 80
        && data.testsCompleted is number && data.testsCompleted >= 0 && data.testsCompleted <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Connection health check path (used on boot)
    match /test/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
    }

    // Teacher administrators collection (read-only for self/admin, writes blocked via client SDK)
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list, create, update, delete: if false;
    }

    // Student Classment Leaderboard Collection (first name, grade, points, badge - zero PII)
    match /rankings/{rankingId} {
      allow get: if isSignedIn() && isValidId(rankingId) && existing().points is number;
      allow list: if isSignedIn() && existing().points is number && existing().points >= 0;

      allow create: if isEmailVerified()
        && isValidId(rankingId)
        && rankingId == request.auth.uid
        && isValidStudentRanking(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isEmailVerified()
        && isValidId(rankingId)
        && isValidStudentRanking(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'firstName',
              'name',
              'grade',
              'points',
              'avatar',
              'badge',
              'testsCompleted',
              'updatedAt'
            ])
          )
        );

      allow delete: if isEmailVerified()
        && isValidId(rankingId)
        && (isAdmin() || existing().ownerUid == request.auth.uid);
    }
  }
}
